# Copy to `.env` and adjust. Never commit `.env`.

# SQLite database file (created automatically). Path is relative to the project root.
DATABASE_URL="file:./prisma/dev.db"

# Public base URL — used for certificate QR codes (/verify/...) in Stage 11.
APP_URL="http://localhost:3000"

# Signs session cookies (min. 32 characters). `npm run setup` fills it in automatically.
# Changing it signs everyone out.
AUTH_SECRET=""

# Optional: where /admin/backups writes database copies (default ./backups).
# BACKUP_DIR="backups"

# Vercel / Turso only (see docs/deploy-vercel.md):
# DATABASE_URL="libsql://<db>-<user>.aws-eu-central-1.turso.io"
# DATABASE_AUTH_TOKEN=""
# BLOB_READ_WRITE_TOKEN is added by Vercel when you connect a Blob store.
